{
    "name": "doppiogancio/mocked-client",
    "description": "A simple way to mock a client",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "mock",
        "http",
        "client",
        "testing",
        "guzzle",
        "php"
    ],
    "require": {
        "php": "^8.2",
        "league/route": "^6.2",
        "psr/log": "^2.0|^3.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "guzzlehttp/guzzle": "^7.8",
        "squizlabs/php_codesniffer": "^3.9",
        "slevomat/coding-standard": "^8.15",
        "phpstan/phpstan": "^2.2",
        "doctrine/coding-standard": "^12.0",
        "symfony/var-dumper": "^6.4"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required to use DoppioGancio\\MockedClient\\Guzzle\\ClientBuilder"
    },
    "authors": [
        {
            "name": "Fabrizio Gargiulo",
            "email": "fabrizio.gargiulo@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "DoppioGancio\\MockedClient\\": "src/MockedClient"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DoppioGancio\\MockedClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-fix": "phpcbf --standard=Doctrine src/ tests/",
        "cs-check": "phpcs --standard=Doctrine src/ tests/",
        "code-review": [
            "@cs-fix",
            "@phpstan",
            "@tests"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    }
}
